{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FSI Toolbox Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assets"],
  "properties": {
    "version": {
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "category",
          "scenarios",
          "technologies",
          "maturity",
          "repositoryUrl",
          "maintainers",
          "lastReviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "category": {
            "enum": [
              "accelerator",
              "reference-architecture",
              "sample",
              "tool",
              "best-practice"
            ]
          },
          "scenarios": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "technologies": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "maturity": {
            "enum": ["experimental", "preview", "production", "archived"]
          },
          "repositoryUrl": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
          },
          "maintainers": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "lastReviewed": {
            "type": "string",
            "format": "date"
          },
          "industries": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "tags": {
            "$ref": "#/$defs/nonEmptyStrings"
          },
          "documentationUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

